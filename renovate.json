{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits", ":timezone(Europe/Madrid)"],
  "schedule": ["* 6-10 * * *"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 8,
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": { "enabled": true, "schedule": ["* 6-10 1 * *"] },
  "packageRules": [
    {
      "description": "Minor/patch/digest bumps ride one weekly PR and merge themselves once CI is green",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Majors wait for a tick in the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Node 24 is the runtime (Docker, CI, the Pi): its image and types stay on 24.x",
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "/^24\\./"
    }
  ]
}
